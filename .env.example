# Node Environment
NODE_ENV=development

# Database Provider (sqlite or mysql)
SQL_PROVIDER=sqlite

# Database URL
# For SQLite (default):
DATABASE_URL="file:./dev.db"

# For MySQL:
# DATABASE_URL="mysql://user:password@localhost:3306/starter_db"

# Auth Session Secret (at least 32 characters long)
NUXT_SESSION_PASSWORD=development-only-session-secret-key-min-32-chars-long!

# Default Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
