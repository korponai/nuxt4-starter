{
  "name": "nuxt4-starter",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run db:generate && nuxt build",
    "dev": "npm run db:generate && nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "npm run db:generate && nuxt prepare",
    "db:prepare": "node prisma/prepare.js",
    "db:generate": "npm run db:prepare && prisma generate --schema=prisma/schema.sqlite.prisma && prisma generate --schema=prisma/schema.mysql.prisma && prisma generate",
    "db:migrate": "node prisma/migrate.js",
    "db:seed": "npm run db:prepare && prisma db seed",
    "db:reset": "npm run db:prepare && prisma migrate reset",
    "db:change-password": "node prisma/change-password.js",
    "db:validate": "npm run db:prepare && prisma validate",
    "db:format": "npm run db:prepare && prisma format",
    "db:push": "npm run db:prepare && prisma db push",
    "openspec": "openspec"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@prisma/client": "^6.19.3",
    "nuxt": "^4.4.8",
    "nuxt-auth-utils": "^0.5.29",
    "pdfmake": "^0.3.11",
    "prisma": "^6.19.3",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "vuetify": "^4.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.14.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/pdfmake": "^0.3.3",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "vite": "^7.3.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
